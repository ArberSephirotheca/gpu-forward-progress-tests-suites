 uint subgroup_size = gl_SubgroupSize;
 uint subgroup_local_id = gl_SubgroupInvocationID;
 uint num_workgroup = gl_NumWorkGroups.x;
 uint workgroup_size = gl_WorkGroupSize.x;
 uint workgroup_id = gl_WorkGroupID.x;
 uint workgroup_base = workgroup_size * workgroup_id;
 _GLF_struct_7 _GLF_struct_replacement_7 = _GLF_struct_7(1, GLF_merged2_0_3_63_3_1_8GLF_merged3_0_1_8_1_1_13_2_1_11read_valsubgroup_basesubgroup_idread_val.xyz.z * subgroup_size, ivec2(1), _GLF_struct_2(true, _GLF_struct_0(bvec4(true), true, mat4x3(1.0)), mat4x3(1.0), _GLF_struct_1(bvec4(true), uvec2(1u), uvec3(1u))), _GLF_struct_6(mat2(1.0), mat2x3(1.0), _GLF_struct_3(bvec3(true), bvec4(true), vec3(1.0), bvec3(true), uvec2(1u)), bvec4(true), _GLF_struct_4(mat2(1.0), mat3x2(1.0), 1), true, _GLF_struct_5(bvec2(true), bvec4(true), ivec4(1), bvec3(true), mat4x2(1.0))));
 GLF_merged2_0_3_63_3_1_8GLF_merged3_0_1_8_1_1_13_2_1_11read_valsubgroup_basesubgroup_idread_val.xyz.y = _GLF_struct_replacement_7.subgroup_base;
 uint virtual_gid = workgroup_base + GLF_merged2_0_3_63_3_1_8GLF_merged3_0_1_8_1_1_13_2_1_11read_valsubgroup_basesubgroup_idread_val.xyz.y + subgroup_local_id;
